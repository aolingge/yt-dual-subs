{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "3.12.6",
  "description": "__MSG_extDesc__",
  "permissions": ["storage", "tabCapture", "offscreen"],
  "optional_host_permissions": ["http://127.0.0.1/*", "https://127.0.0.1/*", "http://localhost/*", "https://localhost/*"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "__MSG_toggleTranslationShortcut__"
    },
    "repeat-sentence": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_repeatShortcut__"
    },
    "reveal-translation": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "__MSG_revealShortcut__"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["word-timing-page.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["site.js", "srt.js", "settings.js", "word-timing.js", "bridge-client.js", "media-clock.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["bilibili-page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["site.js", "srt.js", "settings.js", "word-timing.js", "bridge-client.js", "media-clock.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Dual Subs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
